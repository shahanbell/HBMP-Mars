<view class="page" xmlns:wx="http://www.w3.org/1999/xhtml">
	<view class="page__hd">
		<view class="page__title">离职/退休申请单</view>
	</view>

	<view class="page__bd">

		<form bindreset="formReset">
			<van-cell-group>
				<van-field label="申请人员" value="{{ employeeNo}}-{{employeeName}}" required readonly="true" input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="申请部门" value="{{ depeNo}}-{{deptName}}" required readonly input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="岗位" value="{{post}}-{{postDesc}}" required readonly input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="职等" value="{{ grade}}" required readonly input-align='right' />
			</van-cell-group>


			<van-cell-group>
				<van-field label="是否行政职" value="{{isAdminDesc}}" input-align='right' required readonly placeholder="是否行政职" is-link bindtap="showIsAdminAction" />
			</van-cell-group>
			<van-action-sheet show="{{ isAdminActionShow }}" actions="{{ isAdminActions }}" bind:close="onIsAdminActionsClose" bind:select="onIsAdminActionsSelect">
			</van-action-sheet>


			<van-cell-group>
				<van-field label="首次签订合同日期" value="{{workdateDesc}}" required readonly clearable label-class='resigndateDescClass'  placeholder="请输入首次签订合同日期" bindtap="showWorkdatePicker" input-align='right' >
					<span slot="label">首次签订合同日期</span>
					</van-field>
			</van-cell-group>
			<van-popup show="{{isWorkDatePickerShow}}" position="bottom" bind:close="onWorkDatePickerClose" round>
				<van-datetime-picker min-date="{{mindate}}" t type="date" value="{{workdate}}" bind:confirm="onWorkDatePickerConfirm" bind:cancel="onWorkDatePickerCancel" />
			</van-popup>


			<van-cell-group>
				<van-field label="" value="{{resigndateDesc}}" input-align='right' label-class='resigndateDescClass' required readonly placeholder="请输入申请离职日期" bindtap="showResignDatePicker">
					<span slot="label">申请离职日期</span>
				</van-field>
			</van-cell-group>
			<van-popup show="{{isResignDatePickerShow}}" position="bottom" bind:close="onResignDatePickerClose" round>
				<van-datetime-picker min-date="{{mindate}}" type="date" value="{{resigndate}}" bind:confirm="onResignDatePickerConfirm" bind:cancel="onResignDatePickerCancel" />
			</van-popup>

			<view class="weui-cells__title">离职原因</view>
			<van-cell-group>
				<van-field value="{{ reason }}" custom-style="height:100px" type='textarea' val required clearable placeholder="请输入离职原因" bindblur="bindReasonChange" />
			</van-cell-group>
			<view class="notice-container">
				<view class="notice-content">
					<text class="notice-text">   本人承诺不泄漏贵公司机密(包括技术、工艺、劳动人事、财务等)有形、无形之智能财产及任何破坏公司名誉或不实宣传，自离职/退休之日起1年内不直接或间接使用、申请与本人离职/退休前岗位职责或公司交付的业务有关的技术成果包括但不限于专利。若有违反，愿接受公司追责以及法律制裁。
注:1、正式员工离职须提前1个月，试用期内员工离职须提前3天填写《离职/退休申请单》;
   2、凡组长级(含代组长)以上行政职主管提出离职申请的,须签核至(副)总经理或以上主管。</text>
				</view>
			</view>


			<van-button custom-class="submitbtn" bind:click="formSubmit" type="info" icon="passed" block form-type="submit">提交</van-button>
		</form>
	</view>
</view>