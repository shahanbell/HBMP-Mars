<view class="page" xmlns:wx="http://www.w3.org/1999/xhtml">
	<view class="page__hd">
		<view class="page__title">证明开具申请表</view>
	</view>

	<view class="page__bd">

		<form bindreset="formReset">
			<van-cell-group>
				<van-field label="公司别" value="{{ facno}}-{{facnoname}}" required readonly="true" input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="申请人员" value="{{ employeeNo}}-{{employeeName}}" required readonly="true" input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="申请部门" value="{{ depeNo}}-{{deptName}}" required readonly input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="岗位" value="{{post}}-{{postDesc}}" required readonly input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="职等" value="{{ grade}}" required readonly input-align='right' />
			</van-cell-group>

			<van-cell-group>
				<van-field label="入职日期" value="{{ workStartDateDesc}}" required readonly input-align='right' />
			</van-cell-group>


			<van-cell-group>
				<van-field label="证明类型" value="{{proofType}}-{{proofDesc}}" input-align='right' required readonly placeholder="是否行政职" is-link bindtap="showProofAction" />
			</van-cell-group>
			<van-action-sheet show="{{ isProofActionShow }}" actions="{{ proofTypeActions }}" bind:close="onProofActionsClose" bind:select="onProofActionsSelect">
			</van-action-sheet>

			<van-cell-group>
				<van-field label="申请事由" value="{{reasonCode}}-{{reasonCdesc}}" input-align='right' required readonly is-link bindtap="showReasonAction" />
			</van-cell-group>
			<van-action-sheet show="{{ isReasonActionShow }}" actions="{{ reasonCodeActions }}" bind:close="onReasonActionsClose" bind:select="onReasonActionsSelect">
			</van-action-sheet>

			<van-cell-group>
				<van-field label="贷款金额" value="{{ money}}" input-align='right' bindblur="bindMoneyChange">
					<view slot="right-icon" style="color: #646566; padding-left: 8px;">
						万元
					</view>
				</van-field>
			</van-cell-group>

			<view class="weui-cells__title">说明</view>
			<van-cell-group>
				<van-field model="{{ sumrry }}" custom-style="height:100px" type='textarea' val required clearable placeholder="请输入说明" bindblur="bindSumrryChange" />
			</van-cell-group>

			<van-cell title="图片上传" use-label-slot>
				<view slot="label" class='ui_uploader_cell'>
					<!-- 根据已选择的图片临时路径数组展示图片-->
					<view class='ui_uploader_item' wx:for="{{uploaderList}}" wx:key="{{index}}">
						<!-- 删除-->
						<icon class='ui_uploader_item_icon' bindtap='clearImg' data-index="{{index}}" type="clear" size="20" color="red" />
						<!-- 图片-->
						<image bindtap='showImg' data-index="{{index}}" src='{{item}}'></image>
					</view>
					<!-- 上传按钮+框 -->
					<view class='ui_uploader' bindtap='upload' wx:if="{{showUpload}}"></view>
				</view>
			</van-cell>


			<van-button custom-class="submitbtn" bind:click="formSubmit" type="info" icon="passed" block form-type="submit">提交</van-button>

		</form>
		<van-popup v-model="{{showCountdown}}">内容</van-popup>
	</view>
</view>